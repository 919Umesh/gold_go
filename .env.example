# Server Configuration
PORT=8080

# Appwrite Cloud Configuration
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=698599a4000fcd54a56a
APPWRITE_API_KEY=your_appwrite_api_key_here
APPWRITE_DATABASE_ID=6985bccb00216e0a7171

# Redis Configuration
# For local development
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Alternative: Use REDIS_ADDRESS directly
# REDIS_ADDRESS=localhost:6379

# Worker Configuration
WORKER_COUNT=5
QUEUE_SIZE=100

# JWT Secret (use a strong random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Gold Provider URL
GOLD_PROVIDER_URL=http://localhost:9000

# Database Configuration (if using PostgreSQL - currently using Appwrite)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gold_invest
DB_PORT=5432
